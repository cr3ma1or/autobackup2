# ==============================================================================
# xui-standby-sync Configuration Template
# Copy this file to /etc/x-ui/sync.env, then set secure ownership/permissions:
#   install -o root -g root -m 0600 /etc/x-ui/sync.env
# Generated by install.sh. Edit interactively or manually.
# ==============================================================================

# Telegram Notifications (optional)
SEND_TELEGRAM=0
TG_BOT_TOKEN=""
TG_CHAT_ID=""
TG_PROXY_URL=""

# Network Configuration (Optional)
PRIMARY_IP=""
STANDBY_IP=""
# Space-separated external:primary port mappings; no built-in port fallback.
TRANSIT_PORT_MAP=""

# Comma-separated list of reserved ports
CUSTOM_RESERVED_PORTS=""

# GPG Security Configuration (Critical)
# Comma-separated list of FULL 40-char OpenPGP fingerprints of the primary key.
# Short key IDs are rejected (collision/spoofing risk).
TRUSTED_GPG_SIGNER_FINGERPRINTS=""

# Require GPG signature on backups (default: true)
REQUIRE_GPG_SIGNATURE=1

# Optional path overrides. Defaults are shown; relative values are resolved
# against the invoking process directory and sandbox paths are supported.
TARGET_DB_PATH="/etc/x-ui/x-ui.db"
INCOMING_DIR="/opt/xui-backups/incoming"
WORK_DIR="/opt/xui-backups/.work-sync"
SNAPSHOTS_DIR="/etc/x-ui/standby-snapshots/runs"
GNUPG_DIR="/etc/x-ui/standby/secondary-sync-gnupg"
STANDBY_MODE_FILE="/etc/x-ui/standby-mode"
ALLOWLIST_PATH="/etc/x-ui/standby/allowlist.json"

# Timeouts and Limits
CMD_TIMEOUT=30
MAX_AGE_SECONDS=21600
MAX_CLOCK_SKEW_SECONDS=300
MAX_UNPACK_SIZE_BYTES=524288000
MAX_ROLLBACK_COPIES=5