# ==============================================================================
# Off-site Backup Transfer Configuration
# Copy this file to /etc/x-ui/backup-transfer.env, then set:
#   install -o root -g root -m 0600 /etc/x-ui/backup-transfer.env
# ==============================================================================

# Enable/disable off-site delivery (0=disabled, 1=enabled)
TRANSFER_ENABLED=0

# Remote host (hostname or IP, no spaces)
TRANSFER_HOST=""

# Remote unprivileged SSH receiver user (must match xbackup on secondary)
TRANSFER_USER="xbackup"

# Remote SSH port (default: 22)
TRANSFER_PORT="22"

# Path to dedicated SSH private key (root:root 0600)
TRANSFER_KEY="/etc/x-ui/id_ed25519_backup"

# Path to pinned known_hosts file (root:root 0644 or 0600)
TRANSFER_KNOWN_HOSTS="/etc/x-ui/known_hosts_backup"
