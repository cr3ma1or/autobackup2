# ==============================================================================
# 3x-ui Backup Environment Configuration
# Copy this file to /etc/x-ui/.env, then set secure permissions:
#   install -o root -g root -m 0600 /etc/x-ui/.env
# Generated by install.sh. Edit interactively or manually.
# ==============================================================================

# GPG Recipients (required, full 40-char fingerprints)
# PRIMARY_LOCAL_RECIPIENT  — your own public key (for self-verification)
# SECONDARY_SYNC_RECIPIENT — standby node's public key (for off-site delivery)
PRIMARY_LOCAL_RECIPIENT=""
SECONDARY_SYNC_RECIPIENT=""

# Telegram Notifications (optional)
# SEND_TELEGRAM=1 enables alerts for backup failures/success
SEND_TELEGRAM=0
TG_BOT_TOKEN=""
TG_CHAT_ID=""
TG_PROXY_URL=""

# JSON Export (1=enabled, 0=disabled)
EXPORT_JSON=1